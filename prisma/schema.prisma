datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  cart         Cart?
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  story       String?        // Editorial craft story
  fabric      String?        // e.g. "Handwoven Mulberry Silk with Zari Border"
  stylistNote String?        // Ambient styling companion note
  basePrice   Decimal        @db.Decimal(10, 2)
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    Variant[]
  featured    Boolean        @default(false)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  color     String?  // Optional association with variant color for crossfade
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
}

model Variant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  color         String      // e.g. "Crimson Wine", "Emerald Zari", "Antique Ivory"
  colorHex      String      // e.g. "#58111A", "#0B3B24", "#F7F4EB"
  size          String      // e.g. "XS", "S", "M", "L", "XL"
  sku           String      @unique
  priceOverride Decimal?    @db.Decimal(10, 2)
  active        Boolean     @default(true)
  inventory     Inventory?
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@unique([productId, color, size])
}

model Inventory {
  id        String   @id @default(cuid())
  variantId String   @unique
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Cart {
  id           String     @id @default(cuid())
  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?    @unique
  items        CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId     String
  variant       Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity      Int      @default(1)
  priceSnapshot Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  percentOff    Int       // e.g. 15 for 15% off
  minOrderValue Decimal   @default(0) @db.Decimal(10, 2)
  maxDiscount   Decimal?  @db.Decimal(10, 2)
  expiresAt     DateTime
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model Order {
  id              String               @id @default(cuid())
  orderNumber     String               @unique
  userId          String?
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  email           String
  phone           String
  shippingAddress Json
  subtotal        Decimal              @db.Decimal(10, 2)
  discount        Decimal              @default(0) @db.Decimal(10, 2)
  shipping        Decimal              @default(0) @db.Decimal(10, 2)
  total           Decimal              @db.Decimal(10, 2)
  couponCode      String?
  status          OrderStatus          @default(PENDING)
  paymentMethod   String               @default("SIMULATED_CARD")
  paymentStatus   String               @default("PAID")
  notes           String?
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId            String
  variant              Variant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sku                  String
  title                String
  color                String
  size                 String
  qty                  Int
  unitPriceAtPurchase  Decimal  @db.Decimal(10, 2)
  subtotal             Decimal  @db.Decimal(10, 2)
  createdAt            DateTime @default(now())
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model ChatSession {
  id           String        @id @default(cuid())
  sessionToken String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String      // "user" | "assistant" | "system"
  content    String
  productIds Json?       // Array of product UUIDs recommended
  createdAt  DateTime    @default(now())
}

model UnmetSearchRequest {
  id          String   @id @default(cuid())
  query       String?
  filtersUsed Json?
  sessionId   String?
  createdAt   DateTime @default(now())
}
